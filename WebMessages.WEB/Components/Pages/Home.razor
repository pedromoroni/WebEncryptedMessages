@page "/home"
@using System.Security.Cryptography
@using System.Text
@using WebMessages.WEB.Models

@rendermode InteractiveServer

@inject MySidebarService SidebarService
@inject NavigationManager Navigation
@inject HttpClient httpClient
@inject KeyStorageService KeyStorage
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" />

<div class="d-flex vh-100">
    <WebMessages.WEB.Modals.MySidebar></WebMessages.WEB.Modals.MySidebar>

    <div class="flex-grow-1 d-flex flex-column">
        @if (SidebarService.SelectedContact != null && Helper.LoggedDevice != null)
        {
            <!-- Área de chat -->
            <div class="d-flex flex-column flex-grow-1 bg-light">
                <div id="webmessages-body-container"
                     class="flex-grow-1 p-4 overflow-auto d-flex flex-column gap-2"
                     style="max-height: calc(100% - 90px);">

                    @foreach (var message in SidebarService.SelectedContact.Messages)
                    {
                        <div class="d-flex @(message.FromDeviceId == Helper.LoggedDevice.Id ? "justify-content-end" : "justify-content-start")">
                            <div class="p-2 px-3 rounded-3 shadow-sm"
                                 style="max-width: 70%; background-color:@(message.FromDeviceId == Helper.LoggedDevice.Id ? "#667eea" : "#f1f1f1"); color:@(message.FromDeviceId == Helper.LoggedDevice.Id ? "white" : "black");">
                                @message.Decrypted
                            </div>
                        </div>
                    }
                </div>

                <!-- Input de mensagem -->
                <div id="webmessages-input-container"
                     class="p-3 d-flex align-items-center gap-2">
                    <input id="webmessages-message-input" type="text" @bind-value=@MessageContent placeholder="✍️ Escreva a sua mensagem..." class="form-control border-0 shadow-none
                        rounded-sm px-3" style="background-color: #e6e9ed; height: 44px">

                    <button id="webmessages-submit-message"
                            @onclick=@SendMessage
                            class="btn d-flex align-items-center justify-content-center"
                            style="width: 44px; height: 44px;">
                        <span class="material-symbols-outlined" style="color:#667eea;">
                            send
                        </span>
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="d-flex flex-grow-1 align-items-center justify-content-center text-muted">
                <p>👈 Seleciona um contacto para começar a conversar</p>
            </div>
        }
    </div>
</div>

<style>
    #webmessages-body-container::-webkit-scrollbar {
        width: 6px;
    }

    #webmessages-body-container::-webkit-scrollbar-thumb {
        background-color: rgba(0, 0, 0, 0.2);
        border-radius: 10px;
    }

    #webmessages-body-container::-webkit-scrollbar-track {
        background: transparent;
    }
</style>

<script>
    function ScrollBodyToBottom() {
        const webmessagesBody = document.getElementById('webmessages-body-container');
        if (webmessagesBody) {
            webmessagesBody.scrollTop = webmessagesBody.scrollHeight;
        }
    }
</script>

@code {
    private string MessageContent { get; set; } = string.Empty;

    private List<User> Users { get; set; } = new List<User>();

    private CancellationTokenSource? _cts;

    protected override void OnInitialized()
    {
        SidebarService.OnChange += UpdateStateSafely;
        if (Helper.LoggedUser == null)
        {
            Navigation.NavigateTo("/");
        }
    }

    private Task UpdateStateSafely()
    {
        return InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SidebarService.OnChange -= UpdateStateSafely;
    }


    private async Task SendMessage()
    {
        if (string.IsNullOrEmpty(MessageContent))
        {
            Console.WriteLine("Invalid Message.");
            return;
        }

        if (Helper.LoggedDevice == null)
        {
            Console.WriteLine("Invalid Logged User.");
            Navigation.NavigateTo("/");
            return;
        }

        if (SidebarService.SelectedContact == null)
        {
            return;
        }

        try
        {
            List<Device> toUserdevices = await GetDevicesAsync(SidebarService.SelectedContact.User.Id);
            if (toUserdevices == null || toUserdevices.Count == 0)
                throw new Exception("Recipient User Devices Not Found.");


            var localUserDevices = await GetDevicesAsync(Helper.LoggedUser.Id);
            if (localUserDevices == null || localUserDevices.Count == 0)
                throw new Exception("Local User Devices Not Found.");


            List<Message> toUserEncryptedMessages = EncryptRecipientMessages(toUserdevices);
            List<Message> localUserEncryptedMessages = EncryptSenderMessages(localUserDevices, toUserdevices[0].Id); // encriptar para cada device do user local utilizando o id do primeiro device do destinatario

            SendMessagesRequest sendMessagesRequest = new SendMessagesRequest
            {
                UserCredentials = Helper.LoggedUserCredentials,
                SentMessages = localUserEncryptedMessages,
                ReceivedMessages = toUserEncryptedMessages
            };

            if (toUserEncryptedMessages.Count > 0 && toUserEncryptedMessages.Count == localUserEncryptedMessages.Count)
            {
                var json = JsonSerializer.Serialize(sendMessagesRequest);
                var content = new StringContent(json, Encoding.UTF8, "application/json");
                var sendResponse = await httpClient.PostAsync("Messages/send", content);
                sendResponse.EnsureSuccessStatusCode();

                // por mensagem de sucesso
                MessageContent = string.Empty;
                return;
            }
            // por mensagem de erro
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error sending message: {ex.Message}");
        }
    }

    public async Task<List<Device>> GetDevicesAsync(Guid userId)
    {
        var url = $"Devices/getDevicesByUserId?userId={userId}";
        var response = await httpClient.GetAsync(url);
        response.EnsureSuccessStatusCode();

        return await response.Content.ReadFromJsonAsync<List<Device>>() ?? new List<Device>();
    } 

    public List<Message> EncryptRecipientMessages(List<Device> devices) // encripta todas as mensagens que o destinario recebe
    {
        List<Message> encryptedMessages = new List<Message>();

        foreach (Device device in devices) // encriptar com as public keys de todos os dispositivos
        {
            byte[] recipientPubKey = device.PublicKey;

            var msg = E2E.Encrypt(
                MessageContent,
                fromDeviceId: Helper.LoggedDevice.Id, // ID do dispositivo local
                toDeviceId: device.Id,   // ID do dispositivo remoto
                recipientPublicKey: recipientPubKey
            );

            encryptedMessages.Add(msg);
        }

        return encryptedMessages;
    }

    public List<Message> EncryptSenderMessages(List<Device> devices, Guid toDeviceId) // encripta todas as mensagens que o remetente envia
    {
        List<Message> encryptedMessages = new List<Message>();

        foreach (Device device in devices) // encriptar com as public keys de todos os dispositivos
        {
            byte[] recipientPubKey = device.PublicKey;

            var msg = E2E.Encrypt(
                MessageContent,
                fromDeviceId: device.Id, 
                toDeviceId: toDeviceId,   
                recipientPublicKey: recipientPubKey
            );

            encryptedMessages.Add(msg);
        }

        return encryptedMessages;
    }
}

                