@page "/home"
@using System.Security.Cryptography
@using System.Text
@using WebMessages.WEB.Models

@rendermode InteractiveServer

@inject NavigationManager Navigation
@inject HttpClient httpClient
@inject KeyStorageService KeyStorage

<h3>Send Encrypted Message</h3>

<input type="text"
       value="@Username"
       @oninput="OnInputChanged"
       placeholder="Search User..." />

<select @bind="ToUserId" style="min-width: 200px;">
    <option value="">Select User</option>
    @foreach (User user in Users)
    {
        <option value="@user.Id">@user.Username</option>
    }
</select>

<br />
<input type="text" @bind="MessageContent" placeholder="Type your message..." />
<button @onclick="SendMessage">Send Message</button>

@code {
    private Guid ToUserId { get; set; }
    private string Username { get; set; } = string.Empty;
    private string MessageContent { get; set; } = string.Empty;

    private List<User> Users { get; set; } = new List<User>();

    private CancellationTokenSource? _cts;

    protected override void OnInitialized()
    {
        if (Helper.LoggedUser == null)
        {
            Navigation.NavigateTo("/");
        }
    }

    private async Task OnInputChanged(ChangeEventArgs e)
    {
        Username = e.Value?.ToString() ?? string.Empty;
        await SearchUsersAsync();
    }

    private async Task SearchUsersAsync()
    {
        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        var token = _cts.Token;

        if (string.IsNullOrWhiteSpace(Username))
        {
            Users.Clear();
            return;
        }

        try
        {
            await Task.Delay(300, token);

            var url = $"Users/search?username={Uri.EscapeDataString(Username)}";
            var response = await httpClient.GetAsync(url, token);
            response.EnsureSuccessStatusCode();

            if (!token.IsCancellationRequested && response is not null)
            {
                var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                var users = await response.Content.ReadFromJsonAsync<List<User>>(options);
                Users = users ?? new List<User>();
                StateHasChanged();
            }
        }
        catch (TaskCanceledException) { }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrEmpty(MessageContent))
        {
            Console.WriteLine("Invalid Message.");
            return;
        }

        if (Helper.LoggedDevice == null)
        {
            Console.WriteLine("Invalid Logged User.");
            Navigation.NavigateTo("/");
            return;
        }

        try
        {
            Console.WriteLine($"{Helper.LoggedDevice.Id}\n\n\n");
            List<Device> toUserdevices = await GetDevicesAsync(ToUserId);
            if (toUserdevices == null || toUserdevices.Count == 0)
                throw new Exception("Recipient User Devices Not Found.");


            var localUserDevices = await GetDevicesAsync(Helper.LoggedUser.Id);
            if (localUserDevices == null || localUserDevices.Count == 0)
                throw new Exception("Local User Devices Not Found.");


            List<Message> toUserEncryptedMessages = EncryptRecipientMessages(toUserdevices);
            List<Message> localUserEncryptedMessages = EncryptSenderMessages(localUserDevices, toUserdevices[0].Id); // encriptar para cada device do user local utilizando o id do primeiro device do destinatario

            SendMessagesRequest sendMessagesRequest = new SendMessagesRequest
            {
                UserCredentials = Helper.LoggedUserCredentials,
                SentMessages = localUserEncryptedMessages,
                ReceivedMessages = toUserEncryptedMessages
            };

            if (toUserEncryptedMessages.Count > 0 && toUserEncryptedMessages.Count == localUserEncryptedMessages.Count)
            {
                var json = JsonSerializer.Serialize(sendMessagesRequest);
                var content = new StringContent(json, Encoding.UTF8, "application/json");
                var sendResponse = await httpClient.PostAsync("Messages/send", content);
                sendResponse.EnsureSuccessStatusCode();

                // por mensagem de sucesso
                return;
            }
            // por mensagem de erro
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error sending message: {ex.Message}");
        }
    }

    public async Task<List<Device>> GetDevicesAsync(Guid userId)
    {
        var url = $"Devices/getDevicesByUserId?userId={userId}";
        var response = await httpClient.GetAsync(url);
        response.EnsureSuccessStatusCode();

        return await response.Content.ReadFromJsonAsync<List<Device>>() ?? new List<Device>();
    } 

    public List<Message> EncryptRecipientMessages(List<Device> devices) // encripta todas as mensagens que o destinario recebe
    {
        List<Message> encryptedMessages = new List<Message>();

        foreach (Device device in devices) // encriptar com as public keys de todos os dispositivos
        {
            byte[] recipientPubKey = device.PublicKey;

            var msg = E2E.Encrypt(
                MessageContent,
                fromDeviceId: Helper.LoggedDevice.Id, // ID do dispositivo local
                toDeviceId: device.Id,   // ID do dispositivo remoto
                recipientPublicKey: recipientPubKey
            );

            encryptedMessages.Add(msg);
        }

        return encryptedMessages;
    }

    public List<Message> EncryptSenderMessages(List<Device> devices, Guid toDeviceId) // encripta todas as mensagens que o remetente envia
    {
        List<Message> encryptedMessages = new List<Message>();

        foreach (Device device in devices) // encriptar com as public keys de todos os dispositivos
        {
            byte[] recipientPubKey = device.PublicKey;

            var msg = E2E.Encrypt(
                MessageContent,
                fromDeviceId: device.Id, // ID do dispositivo local
                toDeviceId: toDeviceId,   // ID do dispositivo remoto
                recipientPublicKey: recipientPubKey
            );

            encryptedMessages.Add(msg);
        }

        return encryptedMessages;
    }
}

                