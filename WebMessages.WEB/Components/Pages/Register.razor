@page "/register"
@using WebMessages.WEB.Models.Users

@rendermode InteractiveServer

@inject NavigationManager Navigation
@inject HttpClient httpClient
@inject MySidebarService SidebarService

<PageTitle>Register</PageTitle>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    body {
        background-color: #ffdbe2;
    }

    .container-register {
        width: 100%;
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 15px;
    }

    .wrap-register {
        background: #fff;
        border-radius: 15px;
        overflow: hidden;
        padding: 50px 55px 55px 55px;
        width: 100%;
        max-width: 450px;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.2);
        animation: fadeIn 0.8s ease-in-out;
    }

    .register-form-title {
        display: block;
        font-size: 30px;
        color: #333;
        line-height: 1.2;
        text-align: center;
        margin-bottom: 30px;
        font-weight: bold;
    }

    .form-control {
        border-radius: 25px;
        padding: 12px 20px;
        font-size: 16px;
        box-shadow: none;
        transition: 0.3s;
    }

        .form-control:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
        }

    .btn-register {
        background: #667eea;
        border: none;
        color: white;
        padding: 12px;
        font-size: 18px;
        border-radius: 25px;
        width: 100%;
        transition: background 0.3s ease-in-out;
    }

        .btn-register:hover {
            background: #5a6fe3;
        }

    .login-link {
        display: block;
        text-align: center;
        margin-top: 20px;
        font-size: 15px;
    }

        .login-link a {
            color: #667eea;
            text-decoration: none;
            font-weight: bold;
        }

            .login-link a:hover {
                text-decoration: underline;
            }
</style>

<div class="container-register">
    <div class="wrap-register">
        <form>
            <span class="register-form-title">
                Create Account
            </span>

            @if (ShowErrorMessage)
            {
                <div class="alert alert-danger" role="alert">
                    @ErrorMessageContent
                </div>
            }

            <!-- Username -->
            <div class="mb-4">
                <label class="form-label fw-semibold">Username</label>
                <input type="text" class="form-control" @bind=@UserInfo.Username placeholder="Enter your username" required>
            </div>

            <!-- Password -->
            <div class="mb-4">
                <label class="form-label fw-semibold">Password</label>
                <div class="input-group">
                    <input type="password" class="form-control" id="password" @bind=@UserInfo.Password placeholder="Enter your password" required>
                    <button type="button" class="btn btn-outline-secondary" id="togglePassword">
                        <i id="toggleIcon1" class="fa fa-eye"></i>
                    </button>
                </div>
            </div>

            <!-- Confirm Password -->
            <div class="mb-4">
                <label class="form-label fw-semibold">Confirm Password</label>
                <div class="input-group">
                    <input type="password" class="form-control" id="confirm-password" @bind=@ConfirmPassword placeholder="Enter your password again" required>
                    <button type="button" class="btn btn-outline-secondary" id="toggleConfirmPassword">
                        <i id="toggleIcon2" class="fa fa-eye"></i>
                    </button>
                </div>
            </div>

            <!-- Botao Register -->
            <button type="button" @onclick=@RegisterAsync class="btn-register">
                Register
            </button>

            <div class="login-link">
                Already have an account?
                <a href="/">Login here</a>
            </div>
        </form>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<!-- Mostrar/Ocultar password -->
<script>
    (function() {
        const togglePassword = document.getElementById('togglePassword');
        const toggleConfirmPassword = document.getElementById('toggleConfirmPassword');
        const passwordInput = document.getElementById('password');
        const confirmPasswordInput = document.getElementById('confirm-password');
        const toggleIcon1 = document.getElementById('toggleIcon1');
        const toggleIcon2 = document.getElementById('toggleIcon2');

        if (togglePassword) {
            togglePassword.addEventListener('click', function () {
                const isPassword = passwordInput.type === 'password';
                passwordInput.type = isPassword ? 'text' : 'password';
                toggleIcon1.classList.toggle('fa-eye');
                toggleIcon1.classList.toggle('fa-eye-slash');
            });
        }

        if (toggleConfirmPassword) {
            toggleConfirmPassword.addEventListener('click', function () {
                const isPassword = confirmPasswordInput.type === 'password';
                confirmPasswordInput.type = isPassword ? 'text' : 'password';
                toggleIcon2.classList.toggle('fa-eye');
                toggleIcon2.classList.toggle('fa-eye-slash');
            });
        }
    })();
</script>

@code {
    private UserRequest UserInfo { get; set; } = new UserRequest();
    private string ConfirmPassword { get; set; } = string.Empty; 

    private bool ShowErrorMessage = false;
    private string ErrorMessageContent = string.Empty;

    protected async override Task OnInitializedAsync()
    {
        Helper.LoggedUser = null;
        Helper.LoggedDevice = null;
        SidebarService.ShowSidebar = false;
    }

    private async Task RegisterAsync()
    {
        try
        {
            if (ConfirmPassword != UserInfo.Password)
            {
                ErrorMessageContent = "Passwords don't match. Please try again.";
                ShowErrorMessage = true;
                return;
            }

            CreateUserRequest createUserRequest = new CreateUserRequest
            {
                Credentials = UserInfo,
                ConfirmPassword = ConfirmPassword
            };

            var json = JsonSerializer.Serialize(createUserRequest);

            var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");

            var response = await httpClient.PostAsync("Users/create", content);

            response.EnsureSuccessStatusCode();
            Navigation.NavigateTo("/"); 
        }
        catch (TaskCanceledException ex)
        {
            Console.WriteLine("Request timed out or was canceled: " + ex.Message);
            ShowErrorMessage = true;
        }
        catch (Exception ex)
        {
            ErrorMessageContent = "Invalid username or password. Please try again.";
            ShowErrorMessage = true;
        }
    }
}