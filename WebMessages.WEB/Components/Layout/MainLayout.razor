@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject MySidebarService MySidebarService

<div class="page">
    <WebMessages.WEB.Modals.MySidebar Contacts="MySidebarService.Contacts"></WebMessages.WEB.Modals.MySidebar>
    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>


@code {
    private Task HandleBreadcrumbChanged()
    {
        return InvokeAsync(StateHasChanged);
    }

    protected override void OnInitialized()
    {
        MySidebarService.OnChange += HandleBreadcrumbChanged;
    }

    public void Dispose()
    {
        MySidebarService.OnChange -= HandleBreadcrumbChanged;
    }
}
