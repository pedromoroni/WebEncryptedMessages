@using WebMessages.WEB.Services
@using WebMessages.WEB.Models

@inject KeyStorageService KeyStorageService

@implements IDisposable

@if (MySidebarService.ShowSidebar)
{
    <div class="d-flex flex-column vh-100 border-end bg-light" style="width: 300px; min-width: 280px;">

        <div class="d-flex justify-content-between align-items-center p-3 header text-white shadow-sm">
            <h5 class="mb-0">Web Encrypted Messages</h5>
            <!--<button class="btn btn-sm bg-primary btn-light border-0">
                ⚙️
            </button>-->
        </div>

        <div class="p-3 border-bottom">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0">🔍</span>
                <input type="text" class="form-control border-start-0"
                       value=@UsernameSearch
                       oninput=@OnInputChanged 
                       placeholder="Search User">
            </div>
        </div>

        <ul class="list-unstyled flex-grow-1 overflow-auto m-0 p-2">
            @if (MySidebarService.Contacts != null && MySidebarService.Contacts.Any())
            {
                @foreach (var contact in MySidebarService.Contacts)
                {
                    <li class="d-flex align-items-center p-2 rounded-3 mb-1 hover-bg cursor-pointer" onclick=@(() => OnContactClick(contact))>
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-2" style="width: 48px; height: 48px; font-weight: 600;">
                            @(contact.User != null ? contact.User.Username.Substring(0, 1).ToUpper() : "")
                        </div>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between">
                                <span class="fw-bold text-dark">@(contact.User != null ? contact.User.Username : "")</span>
                                <small class="text-muted">@(contact.Messages.Count > 0 ? contact.Messages[0].DeliveredAt : "")</small>
                            </div>
                            <div>
                                <small class="text-muted">@(contact.Messages.Count > 0 ? contact.Messages[0].Decrypted : "")</small>
                            </div>
                        </div>
                    </li>
                }
            }
            else
            {
                <li class="text-center text-muted p-3">Nenhum contato encontrado.</li>
            }
        </ul>
        <div class="p-3 border-top text-center text-muted small bg-light">
            🔒 End-to-end encrypted messages
        </div>
    </div>

    <style>
        .hover-bg:hover {
            background-color: #e7f1ff;
            transition: background-color 0.2s;
            cursor: pointer;
        }

        .header {
            background-color: #667eea;
        }
    </style>
}

@code {
    private List<MySidebarItem> DecryptedContacts = new ();

    protected override void OnInitialized()
    {
        MySidebarService.OnChange += UpdateStateSafely;
    }

    private Task UpdateStateSafely()
    {
        return InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        MySidebarService.OnChange -= UpdateStateSafely;
    }
}